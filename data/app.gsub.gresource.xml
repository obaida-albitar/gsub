<?xml version="1.0" encoding="UTF-8"?>
<!--
  gresource manifest for gsub.

  Blueprint sources live in data/blueprints/*.blp and are compiled to
  .ui by blueprint-compiler at build time (see meson.build). The generated
  .ui files are listed here via the meson-generated file, and bundled into
  the gresource at resource base path /app/gsub.
-->
<gresources>
  <gresource prefix="/app/gsub">
    <!-- Compiled Blueprint templates (generated by meson into the build dir) -->
    <file alias="window.ui">window.ui</file>
    <file alias="home-screen.ui">home-screen.ui</file>
    <file alias="batch-confirm-dialog.ui">batch-confirm-dialog.ui</file>
    <file alias="batch-operations-panel.ui">batch-operations-panel.ui</file>
    <file alias="batch-file-row.ui">batch-file-row.ui</file>
    <file alias="time-shift.ui">time-shift.ui</file>
    <file alias="bulk-apply-style.ui">bulk-apply-style.ui</file>
    <file alias="track-selection.ui">track-selection.ui</file>
    <file alias="ass-info.ui">ass-info.ui</file>
    <file alias="ass-styles.ui">ass-styles.ui</file>
    <file alias="video-player.ui">video-player.ui</file>
    <file alias="editor-panel.ui">editor-panel.ui</file>
    <file alias="subtitle-list-row.ui">subtitle-list-row.ui</file>
    <file alias="subtitle-list.ui">subtitle-list.ui</file>
    <file alias="batch-file-list.ui">batch-file-list.ui</file>
    <file alias="compatibility-panel.ui">compatibility-panel.ui</file>
    <file alias="style-props-editor.ui">style-props-editor.ui</file>
    <file alias="batch-style-props.ui">batch-style-props.ui</file>

    <!-- App stylesheet -->
    <file alias="style.css">style.css</file>

    <!-- Application icon (referenced as app.gsub) -->
    <file alias="icons/scalable/apps/app.gsub.svg">app.gsub.svg</file>
  </gresource>
</gresources>
