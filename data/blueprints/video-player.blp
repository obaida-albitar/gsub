using Gtk 4.0;

template $GsubVideoPlayer : Gtk.Box {
  orientation: vertical;
  spacing: 0;

  // Video display area. mpv (libmpv) renders the video and subtitles directly
  // into this Gtk.GLArea via its OpenGL render context (see video_player.py).
  Frame video_frame {
    styles ["view"]
    vexpand: true;

    child: GLArea video_area {
      vexpand: true;
      hexpand: true;
    };
  }

  // Compact control bar (OSD style).
  Box controls_box {
    styles ["toolbar", "osd"]
    margin-start: 6;
    margin-end: 6;
    margin-top: 6;
    margin-bottom: 6;
    spacing: 6;

    // Playback controls (linked). All control children are vertically
    // centered so they keep their compact height when the timeline slot
    // grows with the waveform (instead of stretching with the row).
    Box playback_box {
      styles ["linked"]
      valign: center;

      Button skip_back_button {
        icon-name: "media-seek-backward-symbolic";
        tooltip-text: _("Skip backward 5 seconds");
        clicked => $on_skip_back();
      }

      Button play_button {
        icon-name: "media-playback-start-symbolic";
        tooltip-text: _("Play/Pause (Space)");
        clicked => $on_play_pause();
      }

      Button skip_forward_button {
        icon-name: "media-seek-forward-symbolic";
        tooltip-text: _("Skip forward 5 seconds");
        clicked => $on_skip_forward();
      }
    }

    Label time_label {
      styles ["numeric"]
      valign: center;
      width-chars: 5;
      margin-start: 6;
      label: "0:00";
    }

    // Custom timeline (created in code: blueprint cannot reference the
    // app's custom widget types) is packed into this slot.
    Box timeline_slot {
      hexpand: true;
    }

    Label duration_label {
      styles ["numeric", "dim-label"]
      valign: center;
      width-chars: 5;
      margin-end: 6;
      label: "0:00";
    }

    MenuButton volume_button {
      valign: center;
      icon-name: "audio-volume-high-symbolic";
      tooltip-text: _("Volume");

      popover: Popover {
        child: Scale volume_scale {
          orientation: horizontal;
          width-request: 120;
          hexpand: true;
          draw-value: false;
          adjustment: Adjustment {
            lower: 0.0;
            upper: 1.0;
            value: 1.0;
            step-increment: 0.05;
            page-increment: 0.1;
          };
        };
      };
    }

    // Waveform strip toggle (state persists via preferences.conf).
    ToggleButton waveform_toggle {
      valign: center;
      icon-name: "audio-x-generic-symbolic";
      tooltip-text: _("Waveform");
    }

    // Subtitle-size popover button (popover content built from code).
    MenuButton subtitle_size_button {
      valign: center;
      icon-name: "format-text-bold-symbolic";
      tooltip-text: _("Subtitle Size (+ / - / 0)");
    }
  }
}
