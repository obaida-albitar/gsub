using Gtk 4.0;

template $GsubVideoPlayer : Gtk.Box {
  orientation: vertical;
  spacing: 0;

  // Video display area. The paintable (from the GStreamer gtk4paintablesink)
  // is assigned from code once the pipeline is built.
  Frame video_frame {
    styles ["view"]
    vexpand: true;

    child: Overlay overlay {
      // Gtk.Picture for the video; paintable set from code.
      Picture video_picture {
        content-fit: contain;
        vexpand: true;
        can-shrink: true;
      }

      // Subtitle overlay (transparent drawing area, redrawn on demand).
      // [overlay] keeps it as a GtkOverlay overlay child; without it the
      // drawing area would replace the video Picture as the main child and
      // the video would never be visible.
      [overlay]
      DrawingArea subtitle_drawing_area {
        vexpand: true;
        hexpand: true;
        opacity: 1.0;
      }
    };
  }

  // Compact control bar (OSD style).
  Box controls_box {
    styles ["toolbar", "osd"]
    margin-start: 6;
    margin-end: 6;
    margin-top: 6;
    margin-bottom: 6;
    spacing: 6;

    // Playback controls (linked)
    Box playback_box {
      styles ["linked"]

      Button skip_back_button {
        icon-name: "media-seek-backward-symbolic";
        tooltip-text: _("Skip backward 5 seconds");
        clicked => $on_skip_back();
      }

      Button play_button {
        icon-name: "media-playback-start-symbolic";
        tooltip-text: _("Play/Pause (Space)");
        clicked => $on_play_pause();
      }

      Button skip_forward_button {
        icon-name: "media-seek-forward-symbolic";
        tooltip-text: _("Skip forward 5 seconds");
        clicked => $on_skip_forward();
      }
    }

    Label time_label {
      styles ["numeric"]
      width-chars: 5;
      margin-start: 6;
      label: "0:00";
    }

    Scale timeline_scale {
      hexpand: true;
      draw-value: false;
    }

    Label duration_label {
      styles ["numeric", "dim-label"]
      width-chars: 5;
      margin-end: 6;
      label: "0:00";
    }

    MenuButton volume_button {
      icon-name: "audio-volume-high-symbolic";
      tooltip-text: _("Volume");

      popover: Popover {
        child: Scale volume_scale {
          orientation: horizontal;
          width-request: 120;
          hexpand: true;
          draw-value: false;
          adjustment: Adjustment {
            lower: 0.0;
            upper: 1.0;
            value: 1.0;
            step-increment: 0.05;
            page-increment: 0.1;
          };
        };
      };
    }

    // Subtitle-size popover button (popover content built from code).
    MenuButton subtitle_size_button {
      icon-name: "format-text-bold-symbolic";
      tooltip-text: _("Subtitle Size");
    }
  }
}
