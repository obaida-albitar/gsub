using Gtk 4.0;

template $CompatibilityPanel : Gtk.Box {
  orientation: vertical;
  spacing: 0;

  Label count_label {
    visible: true;
    xalign: 0;
    margin-start: 12;
    margin-end: 12;
    margin-top: 8;
    margin-bottom: 4;
    styles ["dim-label"]
  }

  ScrolledWindow scrolled {
    vexpand: true;
    hscrollbar-policy: never;
    vscrollbar-policy: automatic;

    child: Box issues_box {
      orientation: vertical;
      spacing: 8;
      margin-start: 8;
      margin-end: 8;
      margin-top: 8;
      margin-bottom: 8;
    };
  }

  Label empty_label {
    visible: false;
    label: "No compatibility issues found";
    styles ["dim-label"]
  }
}
