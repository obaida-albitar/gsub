using Gtk 4.0;
using Adw 1;

// Batch file list container. The GsubBatchFileRow rows are produced by a
// SignalListItemFactory wired up in code; this template provides the header,
// the scrollable ListView and the empty-state placeholder via a crossfade stack.
template $GsubBatchFileList : Adw.Bin {
  Stack stack {
    transition-type: crossfade;

    StackPage {
      name: "list";

      child: Box outer_box {
        orientation: vertical;

        Box header_box {
          orientation: horizontal;
          spacing: 6;
          margin-start: 12;
          margin-end: 12;
          margin-top: 12;
          margin-bottom: 6;
          hexpand: true;

          Label header_label {
            label: "Files";
            styles ["heading"]
          }

          Label file_count_label {
            styles ["dim-label"]
          }

          Label spacer {
            hexpand: true;
          }

          Label format_badge {
            styles ["dim-label"]
          }
        }

        ScrolledWindow scrolled {
          hscrollbar-policy: never;
          vscrollbar-policy: automatic;
          vexpand: true;

          ListView list_view {
            vexpand: true;
          }
        }
      };
    }

    StackPage {
      name: "empty";

      child: Adw.StatusPage empty_page {
        title: "No Files Loaded";
        description: "Add subtitle files to begin batch processing";
        icon-name: "folder-documents-symbolic";
      };
    }
  }
}
