using Gtk 4.0;
using Adw 1;

// The ScrolledWindow sits at the panel edge so its scrollbar hugs the window;
// the Clamp limits the content width inside it.
template $GsubBatchOperationsPanel : Adw.Bin {
  child: ScrolledWindow panel_scroller {
    hscrollbar-policy: never;
    vscrollbar-policy: automatic;
    vexpand: true;

    child: Adw.Clamp clamp {
      maximum-size: 600;
      margin-top: 12;
      margin-bottom: 12;

      Box groups_box {
        orientation: vertical;
        spacing: 12;

        // --- Time shift ---
        Adw.PreferencesGroup time_shift_group {
          title: _("Time Shift");
          description: _("Shift subtitle timing forward or backward");

          Adw.SpinRow offset_row {
            title: _("Offset");
            subtitle: _("Milliseconds (negative for backward)");
            value: 0.0;
            digits: 0;
            numeric: true;
            adjustment: Adjustment {
              lower: -3600000;
              upper: 3600000;
              step-increment: 100;
              page-increment: 1000;
            };
          }

          Box presets_box {
            margin-start: 12;
            margin-end: 12;
            margin-top: 12;
            margin-bottom: 12;
            halign: center;
            spacing: 6;
            // Preset buttons are populated from code.
          }
        }

        // --- Resolution ---
        Adw.PreferencesGroup resolution_group {
          title: _("Resolution");
          description: _("Change ASS PlayResX/PlayResY resolution");

          Adw.ActionRow res_enable_row {
            title: _("Change Resolution");
            activatable: true;

            [suffix]
            CheckButton res_enable_switch {
              valign: center;
            }
          }

          Adw.SpinRow res_width_row {
            title: _("Width (PlayResX)");
            subtitle: _("ASS reference resolution width");
            value: 0.0;
            digits: 0;
            numeric: true;
            sensitive: false;
            adjustment: Adjustment {
              lower: 1;
              upper: 7680;
              step-increment: 1;
              page-increment: 10;
            };
          }

          Adw.SpinRow res_height_row {
            title: _("Height (PlayResY)");
            subtitle: _("ASS reference resolution height");
            value: 0.0;
            digits: 0;
            numeric: true;
            sensitive: false;
            adjustment: Adjustment {
              lower: 1;
              upper: 4320;
              step-increment: 1;
              page-increment: 10;
            };
          }
        }

        // The GsubStylePropsEditor group (target styles + property rows) is
        // appended from code between the Resolution and Actions groups.

        // --- Actions (kept last; re-appended after the editor in code) ---
        Adw.PreferencesGroup actions_group {
          Box action_box {
            orientation: horizontal;
            spacing: 6;
            margin-top: 12;
            homogeneous: true;
            // Action buttons (Apply Operations / Save All / Save All As) are added from code.
          }
        }
      }
    };
  };
}
