using Gtk 4.0;
using Adw 1;

template $GsubASSStylesDialog : Adw.Dialog {
  title: _("ASS/SSA Styles");
  content-width: 700;
  content-height: 720;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar header {
      show-title: false;

      [start]
      Button cancel_button {
        label: _("Cancel");
        clicked => $on_cancel_clicked();
      }

      [end]
      Button apply_button {
        label: _("Apply");
        styles ["suggested-action"]
        clicked => $on_apply();
      }
    }

    content: Adw.PreferencesPage prefs_page {
      vexpand: true;

      // --- Style editor (for the selected style) ---
      Adw.PreferencesGroup style_editor_group {
        title: _("Style");
        description: _("Edit the selected style's properties");

        Adw.ComboRow style_combo {
          title: _("Style");
          // model set from code.
        }

        Adw.EntryRow style_name {
          title: _("Name");
        }

        Adw.ComboRow style_font {
          title: _("Font");
          // model set from code.
        }

        Label font_warning {
          label: "";
          wrap: true;
          visible: false;
          margin-top: 4;
          margin-bottom: 4;
          styles ["warning"]
        }

        Adw.SpinRow style_fontsize {
          title: _("Font Size");
          adjustment: Adjustment {
            lower: 1;
            upper: 200;
            step-increment: 1;
            page-increment: 10;
          };
        }

        Adw.ActionRow primary_row {
          title: _("Primary Colour");
          activatable: false;

          [suffix]
          ColorDialogButton primary_color_btn {
            valign: center;
            dialog: ColorDialog {
              with-alpha: true;
            };
          }
        }

        Adw.ActionRow outline_row {
          title: _("Outline Colour");
          activatable: false;

          [suffix]
          ColorDialogButton outline_color_btn {
            valign: center;
            dialog: ColorDialog {
              with-alpha: true;
            };
          }
        }

        Adw.ActionRow back_row {
          title: _("Back Colour");
          activatable: false;

          [suffix]
          ColorDialogButton back_color_btn {
            valign: center;
            dialog: ColorDialog {
              with-alpha: true;
            };
          }
        }

        Adw.SwitchRow style_bold {
          title: _("Bold");
        }

        Adw.SwitchRow style_italic {
          title: _("Italic");
        }

        Adw.SwitchRow style_underline {
          title: _("Underline");
        }

        Adw.SwitchRow style_strikeout {
          title: _("StrikeOut");
        }

        Adw.SpinRow style_spacing {
          title: _("Spacing");
          subtitle: _("Extra space between characters");
          digits: 1;
          adjustment: Adjustment {
            lower: -100;
            upper: 100;
            step-increment: 0.1;
            page-increment: 1;
          };
        }

        Adw.SpinRow style_angle {
          title: _("Angle");
          subtitle: _("Rotation in degrees (-360 to 360)");
          adjustment: Adjustment {
            lower: -360;
            upper: 360;
            step-increment: 1;
            page-increment: 10;
          };
        }

        Adw.ActionRow secondary_row {
          title: _("Secondary Colour");
          subtitle: _("Used for karaoke / collapsed styling");
          activatable: false;

          [suffix]
          ColorDialogButton secondary_color_btn {
            valign: center;
            dialog: ColorDialog {
              with-alpha: true;
            };
          }
        }

        Adw.SpinRow style_scale_x {
          title: _("Scale X (%)");
          subtitle: _("Horizontal scaling of the text");
          digits: 1;
          adjustment: Adjustment {
            lower: 1;
            upper: 1000;
            step-increment: 1;
            page-increment: 10;
          };
        }

        Adw.SpinRow style_scale_y {
          title: _("Scale Y (%)");
          subtitle: _("Vertical scaling of the text");
          digits: 1;
          adjustment: Adjustment {
            lower: 1;
            upper: 1000;
            step-increment: 1;
            page-increment: 10;
          };
        }

        Adw.SpinRow style_outline_width {
          title: _("Outline");
          digits: 1;
          adjustment: Adjustment {
            lower: 0;
            upper: 20;
            step-increment: 0.1;
            page-increment: 1;
          };
        }

        Adw.SpinRow style_shadow {
          title: _("Shadow");
          digits: 1;
          adjustment: Adjustment {
            lower: 0;
            upper: 20;
            step-increment: 0.1;
            page-increment: 1;
          };
        }

        Adw.SpinRow style_alignment {
          title: _("Alignment");
          subtitle: _("1-9 (ASS alignment grid)");
          adjustment: Adjustment {
            lower: 1;
            upper: 9;
            step-increment: 1;
            page-increment: 1;
          };
        }
      }

      // --- Layout (margins / border / encoding) ---
      Adw.PreferencesGroup layout_group {
        title: _("Layout");
        description: _("Margins, border style and character encoding");

        Adw.SpinRow style_border_style {
          title: _("Border Style");
          subtitle: _("1 = Outline + Shadow, 3 = Opaque Box");
          adjustment: Adjustment {
            lower: 1;
            upper: 3;
            step-increment: 2;
            page-increment: 2;
          };
        }

        Adw.SpinRow style_margin_l {
          title: _("Margin L");
          subtitle: _("Left margin");
          adjustment: Adjustment {
            lower: 0;
            upper: 9999;
            step-increment: 1;
            page-increment: 10;
          };
        }

        Adw.SpinRow style_margin_r {
          title: _("Margin R");
          subtitle: _("Right margin");
          adjustment: Adjustment {
            lower: 0;
            upper: 9999;
            step-increment: 1;
            page-increment: 10;
          };
        }

        Adw.SpinRow style_margin_v {
          title: _("Margin V");
          subtitle: _("Vertical (bottom) margin");
          adjustment: Adjustment {
            lower: 0;
            upper: 9999;
            step-increment: 1;
            page-increment: 10;
          };
        }

        Adw.SpinRow style_encoding {
          title: _("Encoding");
          subtitle: _("0 = default, 1 = ANSI, 2 = UTF-8 (etc.)");
          adjustment: Adjustment {
            lower: 0;
            upper: 255;
            step-increment: 1;
            page-increment: 10;
          };
        }
      }

      // --- Preview ---
      Adw.PreferencesGroup preview_group {
        Adw.ExpanderRow preview_expander {
          title: _("Preview");
          subtitle: _("Live sample for the selected style");
          expanded: true;

          ScrolledWindow preview_scroller {
            hexpand: true;
            halign: fill;
            vexpand: true;
            min-content-height: 220;
            hscrollbar-policy: never;
            vscrollbar-policy: automatic;

            child: Box preview_frame {
              styles ["ass-preview-frame"]
              orientation: vertical;
              hexpand: true;
              halign: fill;

              Label preview_label {
                styles ["ass-preview-label"]
                xalign: 0.0;
                halign: fill;
                hexpand: true;
                wrap: true;
                wrap-mode: word_char;
                max-width-chars: 0;
                label: _("The quick brown fox jumps over the lazy dog 0123456789");
              }
            };
          }
        }
      }
    };

    [bottom]
    Box action_bar {
      spacing: 8;
      margin-start: 12;
      margin-end: 12;
      margin-top: 8;
      margin-bottom: 8;

      Button add_style_btn {
        icon-name: "list-add-symbolic";
        tooltip-text: _("Add style");
        clicked => $on_add_style();
      }

      Button remove_style_btn {
        icon-name: "list-remove-symbolic";
        styles ["destructive-action"]
        tooltip-text: _("Remove style");
        clicked => $on_remove_style();
      }
    }

  };
}
